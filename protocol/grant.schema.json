{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grant proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["lab", "date", "title", "pitch", "setup"],
  "properties": {
    "lab": {"type": "string", "pattern": "^lab-[a-z0-9-]+$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "title": {"type": "string", "maxLength": 120},
    "pitch": {"type": "string", "maxLength": 600},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particles", "duration", "sample_dt"],
      "properties": {
        "particles": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/particle"}},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "sample_dt": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "$defs": {
    "particle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "pos", "vel"],
      "properties": {
        "species": {"type": "string", "pattern": "^[A-E]$"},
        "pos": {"$ref": "#/$defs/vec2"},
        "vel": {"$ref": "#/$defs/vec2"}
      }
    },
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
  }
}
