{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "lab", "account", "purpose", "setup", "instruments"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}/r\\d+/lab-[a-z0-9-]+/\\d{3}$"},
    "lab": {"type": "string", "pattern": "^lab-[a-z0-9-]+$"},
    "account": {"enum": ["research", "review", "grant"]},
    "purpose": {"type": "string", "maxLength": 500},
    "cites_paper": {"type": "string", "pattern": "^P-\\d{4}$"},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particles", "duration", "sample_dt"],
      "properties": {
        "particles": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/particle"}},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "sample_dt": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["tracker", "census"]}
    }
  },
  "if": {"properties": {"account": {"const": "review"}}, "required": ["account"]},
  "then": {"required": ["cites_paper"]},
  "$defs": {
    "particle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "pos", "vel"],
      "properties": {
        "species": {"type": "string", "pattern": "^[A-E]$"},
        "pos": {"$ref": "#/$defs/vec2"},
        "vel": {"$ref": "#/$defs/vec2"}
      }
    },
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
  }
}
