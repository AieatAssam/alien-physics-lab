{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper review",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_id", "lab", "verdict", "evidence", "comment"],
  "properties": {
    "paper_id": {"$ref": "#/$defs/paper_id"},
    "lab": {"type": "string", "pattern": "^lab-[a-z0-9-]+$"},
    "verdict": {"enum": ["replicated", "falsified", "narrowed", "inconclusive"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request_id"}},
    "proposed_domain": {"$ref": "#/$defs/domain"},
    "comment": {"type": "string", "maxLength": 2000}
  },
  "$defs": {
    "paper_id": {"type": "string", "pattern": "^P-\\d{4}$"},
    "request_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}/r\\d+/lab-[a-z0-9-]+/\\d{3}$"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "r_range", "max_particles"],
      "properties": {
        "species": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-E]$"}},
        "r_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "max_particles": {"type": "integer", "minimum": 1}
      }
    }
  }
}
