{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_id", "lab", "title", "claims", "cites", "supersedes"],
  "properties": {
    "paper_id": {"$ref": "#/$defs/paper_id"},
    "lab": {"type": "string", "pattern": "^lab-[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "cites": {"type": "array", "items": {"$ref": "#/$defs/paper_id"}},
    "supersedes": {"type": "array", "items": {"$ref": "#/$defs/paper_id"}},
    "withdrawn": {"type": "boolean"}
  },
  "$defs": {
    "paper_id": {"type": "string", "pattern": "^P-\\d{4}$"},
    "request_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}/r\\d+/lab-[a-z0-9-]+/\\d{3}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "domain", "predicted_error", "evidence"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^P-\\d{4}-c\\d+$"},
        "statement": {"type": "string", "minLength": 1},
        "domain": {"$ref": "#/$defs/domain"},
        "predicted_error": {"type": "number", "exclusiveMinimum": 0},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/request_id"}}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "r_range", "max_particles"],
      "properties": {
        "species": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-E]$"}},
        "r_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "max_particles": {"type": "integer", "minimum": 1}
      }
    }
  }
}
